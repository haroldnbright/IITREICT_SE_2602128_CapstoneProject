# Copy this file to .env and fill in the values. Never commit .env.

# SQLite database file. Docker Compose overrides this to keep the file in a volume.
DATABASE_URL=sqlite:///./campusbite.db

# Long random string. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# From https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty for OpenAI. To use Google Gemini's free tier instead, set:
#   OPENAI_API_KEY=<your Gemini key from https://aistudio.google.com/apikey>
#   OPENAI_MODEL=gemini-2.5-flash
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
AI_REQUESTS_PER_MINUTE=5
# Total AI questions per day across all users (0 = no limit). Resets at midnight UTC.
AI_DAILY_LIMIT=100

# Where the React app runs (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Remind owners about orders stuck in PLACED/ACCEPTED longer than this
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_INTERVAL_SECONDS=60

# Create demo accounts, restaurants and orders on first start
SEED_DEMO_DATA=true
